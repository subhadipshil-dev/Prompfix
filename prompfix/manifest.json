{
  "manifest_version": 3,
  "name": "Prompfix — Prompt Refiner",
  "version": "1.0",
  "description": "Refine prompts with GPT-4o-mini and keep your API key and history local.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Prompfix",
    "default_icon": {
      "16": "assets/icons/favicon_io/favicon-16x16.png",
      "32": "assets/icons/favicon_io/favicon-32x32.png",
      "192": "assets/icons/favicon_io/android-chrome-192x192.png"
    }
  },
  "icons": {
    "16": "assets/icons/favicon_io/favicon-16x16.png",
    "32": "assets/icons/favicon_io/favicon-32x32.png",
    "192": "assets/icons/favicon_io/android-chrome-192x192.png"
  },
  "background": {
    "service_worker": "background/background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["api.js", "content/content.js"],
      "css": ["content/content.css"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "dashboard.html"
}
